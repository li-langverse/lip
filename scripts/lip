#!/usr/bin/env bash
# lip — Li package manager (phase 8b–8d).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lip-common.sh
source "$ROOT/scripts/lip-common.sh"

usage() {
  cat <<'EOF'
lip — Li package manager

  lip init NAME [--kind library|binary] [--workspace DIR]
  lip add NAME {path=PATH | git=URL [--tag TAG]}
  lip install [--locked]
  lip build
  lip update
  lip tree
  lip lock [--out FILE]
  lip publish [--dry-run] [--git | --github | --registry URL|PATH]
  lip publish --registry URL posts to registry HTTP API (PH-DB-4); PATH writes index.json
  lip publish defaults to --git when [package.repository].url is a hosted remote
  Set LIP_REGISTRY_TOKEN for bearer auth on HTTP registry publish
  lip --version
EOF
}

pkg_dir() {
  if [[ -f ./li.toml ]]; then pwd
  else echo "lip: run from package root (li.toml missing)" >&2; exit 1
  fi
}

lip_lock_write() {
  local pkg="$1" out="${2:-$pkg/li.lock}"
  local lic lit
  lic="$(lip_find_lic "$ROOT")" || { echo "lip: lic not found" >&2; exit 1; }
  lit="$(lip_find_lit "$ROOT" || true)"
  mkdir -p "$pkg/.li/vendor"
  tree="$(lip_tree_digest "$pkg")"
  proof="$(lip_proof_digest "$lic" "$pkg")"
  cov_pct="0"
  if [[ -n "$lit" && -x "$lit" ]]; then
    (cd "$pkg" && "$lit" test --coverage) || true
    cov_pct="$(cat "$pkg/.lit/coverage_pct.txt" 2>/dev/null || echo 0)"
  fi
  sig=""
  if [[ -f "$pkg/.li/publisher.key" ]]; then
    sig="$(openssl pkeyutl -sign -inkey "$pkg/.li/publisher.key" -in <(echo "$tree$proof") 2>/dev/null | base64 | tr -d '\n' || true)"
  fi
  python3 - "$out" "$tree" "$proof" "$sig" "$cov_pct" "$pkg" <<'PY'
import pathlib, re, sys
out, tree, proof, sig, cov, pkg = sys.argv[1:7]
toml = pathlib.Path(pkg) / "li.toml"
deps = []
if toml.exists():
    t = toml.read_text()
    block = re.search(r'\[dependencies\](.*?)(?:\[|\Z)', t, re.S)
    if block:
        for line in block.group(1).splitlines():
            m = re.match(r'(\w+)\s*=\s*\{\s*path\s*=\s*"([^"]+)"', line.strip())
            if m:
                deps.append((m.group(1), m.group(2), "path"))
lines = [
    "# Generated by lip lock",
    "version = 1",
    f'root_tree_digest = "sha256:{tree}"',
    f'proof_digest = "{proof}"',
    f'sig_ed25519 = "{sig}"',
    f"coverage_pct = {cov}",
    "",
]
for name, path, kind in deps:
    lines += [
        "[[packages]]",
        f'name = "{name}"',
        f'source = "{kind}"',
        f'path = "{path}"',
        "",
    ]
pathlib.Path(out).write_text("\n".join(lines))
print(f"wrote {out}")
PY
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|"") usage; exit 0 ;;
  --version|-V) echo "lip 0.1.0"; exit 0 ;;
  init)
    shift
    name="${1:?name required}"
    shift || true
    LI_REPO="${LI_REPO:-}"
    for p in "$ROOT/../li" "$ROOT/../lic"; do
      [[ -f "$p/scripts/li-new-package" ]] && LI_REPO="$p" && break
    done
    [[ -n "$LI_REPO" ]] || { echo "lip init: clone lic beside lip" >&2; exit 1; }
    exec "$LI_REPO/scripts/li-new-package" "$name" --out "${LIP_INIT_OUT:-$ROOT/packages/$name}" "$@"
    ;;
  add)
    shift
    name="${1:?dep name}"; shift
    pkg="$(pkg_dir)"
    spec="${1:?path= or git= required}"
    if [[ "$spec" == path=* ]]; then
      p="${spec#path=}"
      python3 - "$pkg/li.toml" "$name" "$p" <<'PY'
import pathlib, re, sys
p, name, path = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
t = p.read_text() if p.exists() else ""
if "[dependencies]" not in t:
    t += "\n[dependencies]\n"
t = re.sub(rf'(?m)^{re.escape(name)}\s*=.*\n', '', t)
t = t.rstrip() + f'\n{name} = {{ path = "{path}" }}\n'
p.write_text(t)
PY
      echo "lip add: $name -> $p"
    elif [[ "$spec" == git=* ]]; then
      url="${spec#git=}"
      lip_is_hosted_git_url "$url" || {
        echo "lip add: git=URL must be a hosted remote (https://, http://, git@, ssh://)" >&2
        exit 1
      }
      tag=""
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --tag) tag="$2"; shift 2 ;;
          *) echo "lip add: unknown $1" >&2; exit 1 ;;
        esac
      done
      python3 - "$pkg/li.toml" "$name" "$url" "$tag" <<'PY'
import pathlib, re, sys
p, name, url, tag = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
t = p.read_text() if p.exists() else ""
if "[dependencies]" not in t:
    t += "\n[dependencies]\n"
t = re.sub(rf'(?m)^{re.escape(name)}\s*=.*\n', '', t)
line = f'{name} = {{ git = "{url}"'
if tag:
    line += f', tag = "{tag}"'
line += " }\n"
t = t.rstrip() + "\n" + line
p.write_text(t)
PY
      echo "lip add: $name -> git $url${tag:+ @ $tag}"
    else
      echo "lip add: use path=DIR or git=URL [--tag TAG]" >&2
      exit 1
    fi
    ;;
  install)
    shift
    pkg="$(pkg_dir)"
    lic="$(lip_find_lic "$ROOT")"
    mkdir -p "$pkg/.li/vendor"
    lip_install_deps "$pkg" "$lic"
    ;;
  build)
    pkg="$(pkg_dir)"
    "$0" install
    lic="$(lip_find_lic "$ROOT")"
    entry="$pkg/src/lib.li"
    [[ -f "$pkg/src/main.li" ]] && entry="$pkg/src/main.li"
    "$lic" build "$entry" -o "${LIP_BUILD_OUT:-/dev/null}"
    echo "lip build: ok"
    ;;
  update) "$0" lock ;;
  tree)
    pkg="$(pkg_dir)"
    echo "$pkg"
    [[ -f "$pkg/li.lock" ]] && cat "$pkg/li.lock" || echo "(no lockfile — run lip lock)"
    ;;
  lock) shift; out=""; while [[ $# -gt 0 ]]; do case "$1" in --out) out="$2"; shift 2 ;; *) break ;; esac; done
    pkg="$(pkg_dir)"
    lip_lock_write "$pkg" "${out:-$pkg/li.lock}"
    ;;
  publish)
    shift
    dry=false
    mode=""
    reg="$ROOT/registry"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dry-run) dry=true; shift ;;
        --git|--github) mode=git; shift ;;
        --registry) mode=registry; reg="${2:?}"; shift 2 ;;
        *) echo "lip publish: unknown $1" >&2; exit 1 ;;
      esac
    done
    pkg="$(pkg_dir)"
    lic="$(lip_find_lic "$ROOT")"
    lit="$(lip_find_lit "$ROOT")"
    toml="$pkg/li.toml"
    repo_url="$(python3 -c "
import re
t=open('$toml').read()
m=re.search(r'\\[package\\.repository\\].*?url\\s*=\\s*\"([^\"]+)\"', t, re.S)
print(m.group(1) if m else '')
")"
    if [[ -z "$mode" ]]; then
      if [[ -n "$repo_url" ]]; then
        mode=git
      else
        mode=registry
      fi
    fi
    if [[ "$mode" == git && -n "$repo_url" ]]; then
      lip_is_hosted_git_url "$repo_url" || {
        echo "lip publish: [package.repository].url must be a hosted git remote" >&2
        exit 1
      }
    fi
    "$0" lock
    if [[ -n "$lit" ]]; then
      (cd "$pkg" && "$lit" test --coverage) || { echo "lip publish: coverage gate failed" >&2; exit 1; }
    fi
    "$lic" build "$pkg/src/lib.li" -o /dev/null
    name="$(python3 -c "import re; t=open('$toml').read(); m=re.search(r'name\\s*=\\s*\"([^\"]+)\"', t); print(m.group(1))")"
    ver="$(python3 -c "import re; t=open('$toml').read(); m=re.search(r'version\\s*=\\s*\"([^\"]+)\"', t); print(m.group(1))")"
    tree="$(lip_tree_digest "$pkg")"
    proof="$(lip_proof_digest "$lic" "$pkg")"
    cov="$(cat "$pkg/.lit/coverage_pct.txt" 2>/dev/null || echo 0)"
    tag="v${ver}"
    if [[ "$mode" == git ]]; then
      if [[ -z "$repo_url" ]]; then
        echo "lip publish --git: set [package.repository].url in li.toml" >&2
        exit 1
      fi
      if [[ "$dry" == true ]]; then
        echo "lip publish: dry-run ok (git $repo_url @ $tag)"
        exit 0
      fi
      gh_slug="$(python3 -c "u='$repo_url'.rstrip('/'); print(u.split('github.com/')[-1] if 'github.com/' in u else '')")"
      if [[ -n "$gh_slug" ]] && command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
        if ! gh release view "$tag" -R "$gh_slug" >/dev/null 2>&1; then
          notes="Li package ${name} ${ver} (tree sha256:${tree})"
          gh release create "$tag" -R "$gh_slug" --title "${name} ${ver}" --notes "$notes" || true
        fi
      fi
      reg="$ROOT/registry"
    fi
    if [[ "$dry" == true ]]; then
      if lip_registry_is_url "$reg"; then
        echo "lip publish: dry-run ok (registry HTTP $reg packages/$name/versions)"
      else
        echo "lip publish: dry-run ok"
      fi
      exit 0
    fi
    if lip_registry_is_url "$reg"; then
      python3 - "$ROOT" "$reg" "$name" "$ver" "$tree" "$proof" "$cov" "$mode" "$repo_url" "$tag" <<'PY'
import importlib.util
import pathlib
import sys

lip_root = pathlib.Path(sys.argv[1])
base, name, ver, tree, proof, cov, mode, repo_url, tag = sys.argv[2:11]
mod_path = lip_root / "scripts" / "registry_client.py"
spec = importlib.util.spec_from_file_location("registry_client", mod_path)
rc = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rc)
source = None
if mode in ("git", "github") and repo_url:
    source = {"type": "git", "url": repo_url, "tag": tag}
out = rc.publish_version(
    base,
    name,
    version=ver,
    tree_digest=f"sha256:{tree}",
    proof_digest=proof,
    coverage_pct=float(cov),
    source=source,
)
print(f"lip publish: registry HTTP {name}@{ver} -> {out.get('index_url', base)}")
PY
      exit 0
    fi
    mkdir -p "$reg/packages"
    python3 - "$reg/index.json" "$name" "$ver" "$tree" "$proof" "$cov" "$mode" "$repo_url" "$tag" <<'PY'
import json, pathlib, sys
idx, name, ver, tree, proof, cov, mode, repo_url, tag = sys.argv[1:10]
p = pathlib.Path(idx)
data = json.loads(p.read_text()) if p.exists() else {"packages": []}
entry = {
    "name": name, "version": ver,
    "tree_digest": f"sha256:{tree}",
    "proof_digest": proof,
    "coverage_pct": float(cov),
}
if mode in ("git", "github") and repo_url:
    entry["source"] = {"type": "git", "url": repo_url, "tag": tag}
data["packages"] = [x for x in data["packages"] if not (x.get("name")==name and x.get("version")==ver)]
data["packages"].append(entry)
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps(data, indent=2) + "\n")
src = f" git {repo_url}@{tag}" if mode in ("git", "github") else ""
print(f"lip publish: indexed {name}@{ver}{src}")
PY
    ;;
  *)
    echo "lip: unknown command '$cmd'" >&2
    exit 1
    ;;
esac
